# Copy to .env and adjust. .env itself is gitignored because it may hold the
# upload secret.
#
# Version stamp shown in the site footer and /api/v1/health.
VERSION=0.1.0

# Secret the upload tokens are derived from. Generate one with:
#   updatesite token -gen-secret
# Every deployment that should accept the same tokens must use the same value.
UPLOAD_SECRET=
