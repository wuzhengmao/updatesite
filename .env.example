# Copy to .env and adjust. .env itself is gitignored because it may hold the
# upload secret.
#
# Version stamp shown in the site footer and /api/v1/health.
VERSION=0.1.0

# Secret the upload tokens are derived from. Generate one with:
#   updatesite token -gen-secret
# Every deployment that should accept the same tokens must use the same value.
UPLOAD_SECRET=

# The public address visitors use, e.g. https://update.example.com
#
# Leave this unset when a reverse proxy fronts the site and sends
# X-Forwarded-Proto and X-Forwarded-Host: the site then builds absolute URLs
# from those headers, which is what you want, and nothing needs changing when
# the domain changes.
#
# Set it when the container is reached directly on a port that differs from the
# one it listens on — a container cannot see how its ports were mapped. For the
# 8080:80 / 8443:443 mapping in docker-compose.yml that means:
#
#   BASE_URL=https://localhost:8443
#
# Getting this wrong is quiet: the site keeps serving, but every download link
# and redirect points somewhere the visitor cannot reach.
# BASE_URL=
