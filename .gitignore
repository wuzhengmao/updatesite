# Build output
/updatesite
/updatesite.exe
/dist/
/build/

# Local scratch data
/data/
/cache/

# The archive mount point. It holds real releases, which are deployment
# artefacts rather than source: installers are large and often proprietary, so
# they stay out of the repository. Placeholder demo content lives in
# examples/apps instead.
/release/apps/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# TLS certificates, never commit these
/certs/

# Local compose overrides, may hold secrets
.env
